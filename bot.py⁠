async def process_withdrawal_amount(update: Update, context: ContextTypes.DEFAULT_TYPE):
    method = context.user_data.get("withdrawal_method", "UPI")
    args = context.args
    if not args:
        await update.message.reply_text("Specify amount: `/wamount <amount>`")
        return
    try:
        amount = float(args[0])
    except ValueError:
        await update.message.reply_text("Invalid amount.")
        return

    user = update.effective_user
    conn = sqlite3.connect("playverse.db")
    cursor = conn.cursor()
    cursor.execute("SELECT balance, upi, usd_address FROM users WHERE user_id = ?", (user.id,))
    row = cursor.fetchone()
    if not row or row[0] < amount:
        conn.close()
        await update.message.reply_text("Insufficient balance! ❌")
        return

    cursor.execute("UPDATE users SET balance = balance - ? WHERE user_id = ?", (amount, user.id))
    cursor.execute("INSERT INTO transactions (user_id, type, amount, details) VALUES (?, ?, ?, ?)", (user.id, f"WITHDRAWAL_{method}", amount, row[1]))
    tx_id = cursor.lastrowid
    conn.commit()
    conn.close()

    admin_markup = InlineKeyboardMarkup([
        [InlineKeyboardButton("✅ Approve", callback_data=f"admin_w_approve_{tx_id}_{user.id}_{amount}"),
         InlineKeyboardButton("❌ Reject", callback_data=f"admin_w_reject_{tx_id}_{user.id}_{amount}")]
    ])
    await context.bot.send_message(chat_id=ADMIN_CHAT_ID, text=f"🔔 Withdrawal Request\nUser: `{user.id}`\nAmount: `{amount}`", reply_markup=admin_markup, parse_mode="Markdown")
    await update.message.reply_text("Withdrawal request sent successfully! ⏳")

