import sqlite3
from telegram import Update, InlineKeyboardButton, InlineKeyboardMarkup
from telegram.ext import Application, CommandHandler, MessageHandler, CallbackQueryHandler, ContextTypes, filters

TOKEN = "8955259098:AAEHDsM2TvsMNrAI1SNz1zyQC5UbCtw_rk4"
ADMIN_CHAT_ID = 8955259098

# --- DATABASE SETUP ---
def init_db():
    conn = sqlite3.connect("playverse.db")
    cursor = conn.cursor()
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS users (
            user_id INTEGER PRIMARY KEY,
            username TEXT,
            balance REAL DEFAULT 0.00,
            upi TEXT DEFAULT 'Not Set'
        )
    """)
    conn.commit()
    conn.close()

init_db()

# --- START COMMAND ---
async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = update.effective_user
    conn = sqlite3.connect("playverse.db")
    cursor = conn.cursor()
    cursor.execute("INSERT OR IGNORE INTO users (user_id, username) VALUES (?, ?)", (user.id, user.username))
    conn.commit()
    conn.close()

    keyboard = [
        [InlineKeyboardButton("💰 Check Balance", callback_data="balance")],
        [InlineKeyboardButton("⚙️ Set UPI", callback_data="set_upi")]
    ]
    reply_markup = InlineKeyboardMarkup(keyboard)
    
    await update.message.reply_text(
        f"Welcome to Playverse Bot, {user.first_name}!\nChoose an option below:",
        reply_markup=reply_markup
    )

# --- BUTTON HANDLER ---
async def button_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    
    user_id = query.from_user.id
    
    if query.data == "balance":
        conn = sqlite3.connect("playverse.db")
        cursor = conn.cursor()
        cursor.execute("SELECT balance, upi FROM users WHERE user_id = ?", (user_id,))
        row = cursor.fetchone()
        conn.close()
        
        balance = row[0] if row else 0.00
        upi = row[1] if row else "Not Set"
        
        await query.message.edit_text(f"💰 Your Balance: ₹{balance}\n📱 Registered UPI: {upi}")
        
    elif query.data == "set_upi":
        await query.message.edit_text("Please send your UPI ID in the next message (e.g., yourname@paytm).")
        context.user_data["waiting_for_upi"] = True

# --- MESSAGE HANDLER ---
async def handle_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if context.user_data.get("waiting_for_upi"):
        user_id = update.effective_user.id
        upi_id = update.message.text
        
        conn = sqlite3.connect("playverse.db")
        cursor = conn.cursor()
        cursor.execute("UPDATE users SET upi = ? WHERE user_id = ?", (upi_id, user_id))
        conn.commit()
        conn.close()
        
        context.user_data["waiting_for_upi"] = False
        await update.message.reply_text(f"✅ Success! Your UPI has been updated to: {upi_id}")

# --- MAIN FUNCTION ---
def main():
    application = Application.builder().token(TOKEN).build()

    application.add_handler(CommandHandler("start", start))
    application.add_handler(CallbackQueryHandler(button_handler))
    application.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_message))

    print("Bot is starting...")
    application.run_polling()

if __name__ == "__main__":
    main()
