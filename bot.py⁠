# --- ADMIN & UTILS ---
async def admin_callback(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    data = query.data
    if data.startswith("admin_w_"):
        parts = data.split("_")
        action, tx_id, user_id, amount = parts[2], parts[3], int(parts[4]), float(parts[5])
        conn = sqlite3.connect("playverse.db")
        cursor = conn.cursor()
        if action == "approve":
            cursor.execute("UPDATE transactions SET status = 'APPROVED' WHERE tx_id = ?", (tx_id,))
            conn.commit()
            conn.close()
            await query.message.edit_text(f"✅ Withdrawal #{tx_id} Approved.")
            await context.bot.send_message(chat_id=user_id, text=f"✅ Withdrawal of {amount} approved & paid out!")
        else:
            cursor.execute("UPDATE users SET balance = balance + ? WHERE user_id = ?", (amount, user_id))
            cursor.execute("UPDATE transactions SET status = 'REJECTED' WHERE tx_id = ?", (tx_id,))
            conn.commit()
            conn.close()
            await query.message.edit_text(f"❌ Withdrawal #{tx_id} Rejected (Refunded).")
            await context.bot.send_message(chat_id=user_id, text=f"❌ Withdrawal of {amount} rejected. Funds refunded.")

async def handle_messages(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if context.user_data.get("awaiting_utr"):
        proof = update.message.text
        context.user_data["awaiting_utr"] = False
        await update.message.reply_text("Wait for admin approval ⏳")
        await context.bot.send_message(chat_id=ADMIN_CHAT_ID, text=f"📥 **Deposit Proof**\nUser: `{update.effective_user.id}`\nProof: `{proof}`", parse_mode="Markdown")

