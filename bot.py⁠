# --- GAMES (Dice Low/High) ---
async def play_dice(update: Update, context: ContextTypes.DEFAULT_TYPE):
    args = context.args
    if len(args) < 2:
        await update.message.reply_text("Usage: `/dice <amount> <low/high>` (e.g., `/dice 10 high`)")
        return

    try:
        amount = float(args[0])
    except ValueError:
        await update.message.reply_text("Invalid bet amount.")
        return

    prediction = args[1].lower()
    if prediction not in ["low", "high"]:
        await update.message.reply_text("Please specify either 'low' (1-3) or 'high' (4-6).")
        return

    user = update.effective_user
    conn = sqlite3.connect("playverse.db")
    cursor = conn.cursor()
    cursor.execute("SELECT balance FROM users WHERE user_id = ?", (user.id,))
    row = cursor.fetchone()
    if not row or row[0] < amount:
        conn.close()
        await update.message.reply_text("Insufficient balance!")
        return

    cursor.execute("UPDATE users SET balance = balance - ?, total_wagered = total_wagered + ? WHERE user_id = ?", (amount, amount, user.id))
    conn.commit()
    conn.close()

    roll = random.randint(1, 6)
    is_low = roll in [1, 2, 3]
    win = (prediction == "low" and is_low) or (prediction == "high" and not is_low)
    
    payout = calculate_payout(amount) if win else 0.0

    conn = sqlite3.connect("playverse.db")
    cursor = conn.cursor()
    if win:
        cursor.execute("UPDATE users SET balance = balance + ?, wins = wins + 1 WHERE user_id = ?", (payout, user.id))
        conn.commit()
        conn.close()
        await update.message.reply_text(f"🎲 Dice rolled: **{roll}**\n🎉 You WON ₹{payout:.2f}!")
    else:
        cursor.execute("UPDATE users SET losses = losses + 1 WHERE user_id = ?", (user.id,))
        conn.commit()
        conn.close()
        await update.message.reply_text(f"🎲 Dice rolled: **{roll}**\n😢 You lost ₹{amount:.2f}.")

# --- ADMIN APPROVAL HANDLER ---
async def admin_callback(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    data = query.data

    if data.startswith("admin_w_"):
        parts = data.split("_")
        action = parts[2]
        tx_id = parts[3]
        user_id = int(parts[4])
        amount = float(parts[5])

        conn = sqlite3.connect("playverse.db")
        cursor = conn.cursor()
        if action == "approve":
            cursor.execute("UPDATE transactions SET status = 'APPROVED' WHERE tx_id = ?", (tx_id,))
            conn.commit()
            conn.close()
            await query.message.edit_text(f"✅ Withdrawal #{tx_id} Approved & Paid out.")
            await context.bot.send_message(chat_id=user_id, text=f"✅ Your withdrawal of {amount} has been approved and paid out!")
        else:
            cursor.execute("UPDATE users SET balance = balance + ? WHERE user_id = ?", (amount, user_id))
            cursor.execute("UPDATE transactions SET status = 'REJECTED' WHERE tx_id = ?", (tx_id,))
            conn.commit()
            conn.close()
            await query.message.edit_text(f"❌ Withdrawal #{tx_id} Rejected (Funds refunded).")
            await context.bot.send_message(chat_id=user_id, text=f"❌ Your withdrawal request of {amount} was rejected. Funds refunded.")

# --- MESSAGE HANDLERS (UTR / Proof Submissions) ---
async def handle_messages(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if context.user_data.get("awaiting_utr"):
        proof = update.message.text
        context.user_data["awaiting_utr"] = False
        await update.message.reply_text("Wait for admin approval ⏳")
        await context.bot.send_message(
            chat_id=ADMIN_CHAT_ID,
            text=f"📥 **New Deposit Proof**\nUser ID: `{update.effective_user.id}`\nProof/UTR/TxID: `{proof}`",
            parse_mode="Markdown"
        )

def main():
    application = Application.builder().token(TOKEN).build()

    application.add_handler(CommandHandler("start", start))
    application.add_handler(CommandHandler(["wallet", "balance"], wallet_balance))
    application.add_handler(CommandHandler("saveupi", saveupi))
    application.add_handler(CommandHandler("saveusd", saveusd))
    application.add_handler(CommandHandler("deposit", deposit))
    application.add_handler(CommandHandler("withdraw", withdraw))
    application.add_handler(CommandHandler("withdrawcrypto", withdrawcrypto))
    application.add_handler(CommandHandler("dice", play_dice))
    
    application.add_handler(CallbackQueryHandler(deposit_callback, pattern="^dep_"))
    application.add_handler(CallbackQueryHandler(admin_callback, pattern="^admin_w_"))
    application.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_messages))

    print("Playverse Bot is running...")
    application.run_polling()

if __name__ == "__main__":
    main()

