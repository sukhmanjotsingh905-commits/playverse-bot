# --- WITHDRAWAL SYSTEM (UPI & Crypto) ---
async def withdraw(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = update.effective_user
    args = context.args
    if not args:
        await update.message.reply_text("Usage: `/withdraw <amount>` (Min ₹50)")
        return
    
    try:
        amount = float(args[0])
    except ValueError:
        await update.message.reply_text("Invalid amount format.")
        return

    if amount < 50:
        await update.message.reply_text("Minimum withdrawal is ₹50.00 ⚠️")
        return

    conn = sqlite3.connect("playverse.db")
    cursor = conn.cursor()
    cursor.execute("SELECT balance, upi FROM users WHERE user_id = ?", (user.id,))
    row = cursor.fetchone()
    if not row or row[0] < amount:
        conn.close()
        await update.message.reply_text("Insufficient balance for withdrawal! ❌")
        return
    
    upi = row[1]
    if upi == "Not Set":
        conn.close()
        await update.message.reply_text("Please save your UPI ID first using `/saveupi <upi>`.")
        return

    cursor.execute("UPDATE users SET balance = balance - ? WHERE user_id = ?", (amount, user.id))
    cursor.execute("INSERT INTO transactions (user_id, type, amount, details) VALUES (?, 'WITHDRAWAL_UPI', ?, ?)", (user.id, amount, upi))
    tx_id = cursor.lastrowid
    conn.commit()
    conn.close()

    admin_markup = InlineKeyboardMarkup([
        [InlineKeyboardButton("✅ Approve", callback_data=f"admin_w_approve_{tx_id}_{user.id}_{amount}"),
         InlineKeyboardButton("❌ Reject", callback_data=f"admin_w_reject_{tx_id}_{user.id}_{amount}")]
    ])
    await context.bot.send_message(
        chat_id=ADMIN_CHAT_ID,
        text=f"🔔 **New UPI Withdrawal Request**\nUser ID: `{user.id}`\nAmount: ₹{amount}\nUPI: `{upi}`",
        reply_markup=admin_markup,
        parse_mode="Markdown"
    )
    await update.message.reply_text("UPI Withdrawal request submitted! Waiting for admin approval. ⏳")

