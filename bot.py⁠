# --- DATABASE SETUP ---
def init_db():
    conn = sqlite3.connect("playverse.db")
    cursor = conn.cursor()
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS users (
            user_id INTEGER PRIMARY KEY,
            username TEXT,
            balance REAL DEFAULT 0.00,
            upi TEXT DEFAULT 'Not Set'
        )
    """)
    conn.commit()
    conn.close()

init_db()

